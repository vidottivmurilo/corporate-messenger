{
  "name": "corporate-messenger-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=@corp-messenger/server run dev",
    "dev:web": "npm --workspace=@corp-messenger/web run dev",
    "build": "npm run --workspaces build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
